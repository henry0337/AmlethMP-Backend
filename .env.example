# --- Postgres (dùng bởi cả compose lẫn app) ---
POSTGRES_DB=amlethmp
POSTGRES_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# R2DBC URL (Spring đọc qua biến DB_HOST). KHÔNG phải hostname — là URL đầy đủ.
DB_HOST=r2dbc:postgresql://localhost:5432/amlethmp
# JDBC URL cho Liquibase (chạy migration lúc startup).
LIQUIBASE_HOST=jdbc:postgresql://localhost:5432/amlethmp
LIQUIBASE_ENABLE=true

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

# --- JWT (đổi thành secret đủ dài, >= 256-bit cho HS256) ---
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

# --- Mail (Gmail SMTP — dịch vụ NGOÀI, không nằm trong compose) ---
# Dùng App Password của Gmail, không phải mật khẩu đăng nhập thường.
MAIL_ACCOUNT=your-account@gmail.com
MAIL_PASSWORD=your-gmail-app-password
