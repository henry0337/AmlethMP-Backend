<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260630-create-playlist-songs-table" author="Himekawa">
        <createTable tableName="playlist_songs">
            <column name="playlist_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_playlist_songs_playlist_id"
                             references="playlists(id)"/>
            </column>
            <column name="song_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_playlist_songs_song_id"
                             references="songs(id)"/>
            </column>
            <column name="position" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="added_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="added_by" type="UUID">
                <constraints foreignKeyName="fk_playlist_songs_added_by"
                             references="users(id)"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="playlist_songs"
                       columnNames="playlist_id, song_id"
                       constraintName="pk_playlist_songs"/>
    </changeSet>

</databaseChangeLog>
