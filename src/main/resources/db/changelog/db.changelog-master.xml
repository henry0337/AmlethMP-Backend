<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260630-create-users-table" author="Himekawa">
        <createTable tableName="users">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="version" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(255)">
                <constraints nullable="false"
                             unique="true"
                             uniqueConstraintName="uq_users_email"/>
            </column>
            <column name="display_name" type="varchar(255)"/>
            <column name="avatar_url" type="varchar(1024)"/>
            <column name="password" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="is_account_expired" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_account_locked" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_credentials_expired" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_disabled" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="last_disabled_by" type="varchar(255)"/>
            <column name="last_disabled_at" type="timestamp with time zone"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="last_updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_updated_by" type="varchar(255)"/>
        </createTable>

        <addCheckConstraint tableName="users"
                            constraintName="chk_users_role"
                            condition="role IN ('ADMIN', 'USER')"/>
    </changeSet>

    <!-- catalog core: artists → genres → albums → songs -->
    <include file="changes/20260630-create-artists-table.xml" relativeToChangelogFile="true"/>
    <include file="changes/20260630-create-genres-table.xml" relativeToChangelogFile="true"/>
    <include file="changes/20260630-create-albums-table.xml" relativeToChangelogFile="true"/>
    <include file="changes/20260630-create-songs-table.xml" relativeToChangelogFile="true"/>

    <!-- catalog junctions: phụ thuộc songs, artists, genres -->
    <include file="changes/20260630-create-song-artists-table.xml" relativeToChangelogFile="true"/>
    <include file="changes/20260630-create-song-genres-table.xml" relativeToChangelogFile="true"/>

    <!-- playlists: phụ thuộc users, songs -->
    <include file="changes/20260630-create-playlists-table.xml" relativeToChangelogFile="true"/>
    <include file="changes/20260630-create-playlist-songs-table.xml" relativeToChangelogFile="true"/>

    <!-- library (user interactions): phụ thuộc users, songs, albums, artists, playlists -->
    <include file="changes/20260630-create-user-liked-songs-table.xml" relativeToChangelogFile="true"/>
    <include file="changes/20260630-create-user-liked-albums-table.xml" relativeToChangelogFile="true"/>
    <include file="changes/20260630-create-user-followed-artists-table.xml" relativeToChangelogFile="true"/>
    <include file="changes/20260630-create-user-followed-playlists-table.xml" relativeToChangelogFile="true"/>

    <!-- history: phụ thuộc users, songs -->
    <include file="changes/20260630-create-listening-history-table.xml" relativeToChangelogFile="true"/>
</databaseChangeLog>
